# Following Two Lines are the Terminal Wakatime setup
export PATH="$HOME/.wakatime:$PATH"
eval "$(terminal-wakatime init)"

alias less='less --RAW-CONTROL-CHARS'
export LS_OPTS='--color=auto'
alias ls='ls ${LS_OPTS}'

alias neofetch='fastfetch --config neofetch'
alias vim='nvim'

alias run='./run.sh'
alias compile='./compile.sh'

alias projects="cd ~/Projects/Programming"

alias q="exit"

alias archwiki="cd /usr/share/doc/arch-wiki/html/en/"

# Corrections
alias sl='ls'
alias dc='cd'
